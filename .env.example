# MongoDB Atlas Connection URI (Must allow 0.0.0.0/0 IP in Atlas Network Access)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.tv1giow.mongodb.net/nirvaya_db?retryWrites=true&w=majority&appName=Cluster0

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials
ADMIN_EMAIL=admin@nirvaya.com
ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_NAME=Super Administrator

# Production Public Site URL (e.g., https://nirvaya-eyecare.vercel.app or your custom domain)
NEXT_PUBLIC_SITE_URL=https://nirvayaeyecare.com
